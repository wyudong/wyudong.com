---
const GITHUB_URL = 'https://github.com/wyudong';
---

<footer class="footer">
  <span>© 2026 wyudong.com</span>
  <a class="github" href={GITHUB_URL} target="_blank">
    github ↗
  </a>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    padding: 22px 0 30px;
    border-top: 1px solid var(--color-line);
    font-size: 12px;
    color: var(--color-muted);
  }
  .github {
    transition: color 0.2s;
  }
  .github:hover {
    color: var(--color-ink);
  }
  @media print {
    .footer {
      display: none;
    }
  }
</style>
