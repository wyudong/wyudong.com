---
import { langOf } from '../i18n';

const t = {
  zh: {
    // 两句随滚动换，见下面的 .scroll
    title: ['紙上得來終覺淺，', '絕知此事要躬行。'],
    titleMode: 'scroll',
    description:
      '最擅长 Web 全栈，也做桌面端和移动端，还为企业搭建自动化流程。喜欢先弄明白问题，再把它做成好用的产品。',
    cta: '看看我的作品',
    canvas: '整理色块：鼠标经过或点击整理附近黄色方块',
    hint: '试着动一动',
    scattered: '已重新打散。移动鼠标或点击，整理附近的黄色方块。',
    partial: '这一片已经理清楚了。可以继续整理其他位置。',
    done: '黄色方块已全部整理完成。',
  },
  en: {
    // 三句轮播，见下面的 .rotate
    title: ['I hear, I know.', 'I see, I remember.', 'I do, I understand.'],
    titleMode: 'rotate',
    description:
      'I specialize in full-stack web development, with experience in desktop and mobile apps and business automation. My approach is to understand the problem first, then build a product that is easy to use.',
    cta: 'See my work',
    canvas: 'Move the pointer or click to align nearby yellow blocks',
    hint: 'Move the pointer',
    scattered: 'Blocks scattered. Move the pointer or click to align them.',
    partial: 'This area is aligned. Try another area.',
    done: 'All yellow blocks are aligned.',
  },
}[langOf(Astro)];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="copy">
    <h1 id="hero-title" class={t.titleMode} data-scroll-title={t.titleMode === 'scroll' ? '' : undefined}>
      {t.title.map((line, i) => (
        <span class="line" style={`--i: ${i}`}>
          {line}
        </span>
      ))}
    </h1>
    <p class="description">{t.description}</p>
    <div class="actions">
      <a class="primary" href="#projects">
        {t.cta}
      </a>
    </div>
  </div>

  <div class="playground" data-field>
    <div class="canvas-wrap">
      <canvas tabindex="0" role="button" aria-label={t.canvas} aria-describedby="play-hint"></canvas>
      <noscript>
        <div class="art-fallback" aria-hidden="true"></div>
      </noscript>
    </div>
    <div class="play-foot">
      <p class="hint" id="play-hint">
        {t.hint}
      </p>
    </div>
    <p
      class="sr-only"
      aria-live="polite"
      data-status
      data-msg-scattered={t.scattered}
      data-msg-partial={t.partial}
      data-msg-done={t.done}
    ></p>
  </div>
</section>

<script>
  import { initField } from '../scripts/field';
  import { initScrollTitle } from '../scripts/scroll-title';

  document.querySelectorAll<HTMLElement>('[data-field]').forEach(initField);
  document.querySelectorAll<HTMLElement>('[data-scroll-title]').forEach(initScrollTitle);
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.06fr 1fr;
    align-items: center;
    min-height: clamp(560px, calc(100svh - 235px), 730px);
    gap: 5px;
    padding: 26px 0 40px;
  }
  .copy {
    position: relative;
    z-index: 1;
    padding: 15px 0 40px;
  }
  h1 {
    font-size: 60px;
    line-height: 1.37;
    letter-spacing: 0;
    font-weight: 600;
    margin: 0 0 28px;
    word-break: keep-all;
  }
  .line {
    display: block;
  }
  /*
   * 英文标题三句轮播：三句叠在同一格里，高度取最高的一句，切换时下面的内容不跳。
   * 三句一轮 10 秒，一句占 10/3 秒：淡入 1 秒、完整显示 1.3 秒、淡出 1 秒。一轮取 10 秒是为了关键帧都是整数：
   * 10% = 1 秒淡入完，23% = 2.3 秒开始淡出，33% = 3.3 秒淡出完，离下一句开始还有 0.03 秒。
   * 关键帧按三句写死，改句数要一起改。第一句延迟 -1 秒（10% 处），打开页面时已经完整显示。
   * 开启减弱动效时 global.css 关掉动画，只显示第一句。读屏软件按顺序读出三句。
   */
  .rotate {
    display: grid;
    font-family: 'Plus Jakarta Sans Italic', var(--font-sans);
    font-style: italic;
  }
  .rotate .line {
    grid-area: 1 / 1;
    opacity: 0;
    animation: hero-line 10s calc(var(--i) * 10s / 3 - 1s) infinite both;
  }
  .rotate .line:first-child {
    opacity: 1;
  }
  @keyframes hero-line {
    0% {
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    23% {
      opacity: 1;
    }
    33%,
    100% {
      opacity: 0;
    }
  }
  /*
   * 中文标题两句随滚动换：两句叠在同一格里，src/scripts/scroll-title.ts 按滚动写进度 --p（0–1）。
   * 只变透明度：第一句在 0–0.5 之间淡出，第二句在 0.5–1 之间淡入，两句不交叠。
   * 没有脚本时 --p 停在 0，只显示第一句。读屏软件两句都读。
   */
  .scroll {
    --p: 0;
    display: grid;
  }
  .scroll .line {
    grid-area: 1 / 1;
    will-change: opacity;
  }
  .scroll .line:nth-child(1) {
    --t: clamp(0, var(--p) / 0.5, 1);
    opacity: calc(1 - var(--t));
  }
  .scroll .line:nth-child(2) {
    --t: clamp(0, (var(--p) - 0.5) / 0.5, 1);
    opacity: var(--t);
  }
  .description {
    font-size: 16px;
    line-height: 1.95;
    max-width: 29em;
    margin: 0;
    color: #555a52;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 26px;
    margin-top: 34px;
    flex-wrap: wrap;
  }
  .primary {
    /* 按钮文字不参与选中 */
    -webkit-user-select: none;
    user-select: none;
    display: inline-flex;
    align-items: center;
    gap: 24px;
    background: var(--color-ink);
    color: white;
    padding: 15px 26px;
    border-radius: 50px;
    font-size: 15px;
    transition:
      transform 0.2s,
      background 0.2s;
  }
  .primary:hover {
    background: #3b4035;
    transform: translateY(-2px);
  }
  .canvas-wrap {
    width: 100%;
    height: clamp(320px, calc(100svh - 340px), 510px);
    position: relative;
  }
  canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: crosshair;
    touch-action: pan-y;
    border-radius: 22px;
  }
  .art-fallback {
    position: absolute;
    inset: 20%;
    background: repeating-conic-gradient(var(--color-yellow) 0% 25%, var(--color-ink) 0% 50%) 50% / 60px 60px;
    border-radius: 50%;
  }
  /* 提示放在动画容器右下方，贴近画布 */
  .play-foot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    margin: -8px 12px 0 26px;
    min-height: 24px;
  }
  .hint {
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.7;
    margin: 0;
  }
  .hint::before {
    content: '↖';
    margin-right: 7px;
    color: var(--color-ink);
  }

  /* 字号跟版心跳档：1248 / 1008 / 714 */
  @media (width < 1440px) {
    h1 {
      font-size: 52px;
    }
  }
  @media (width < 1200px) {
    .hero {
      grid-template-columns: 1.12fr 1fr;
    }
    h1 {
      font-size: 42px;
    }
    .play-foot {
      margin-left: 0;
    }
    .hint {
      font-size: 12px;
    }
  }
  @media (width < 810px) {
    .hero {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
      padding: 42px 0 27px;
      gap: 0;
    }
    .copy {
      padding: 0;
    }
    h1 {
      font-size: clamp(30px, 7.8vw, 54px);
      line-height: 1.45;
      margin-bottom: 23px;
    }
    .description {
      line-height: 1.9;
      max-width: 36em;
    }
    .actions {
      margin-top: 25px;
      gap: 24px;
    }
    .primary {
      padding: 13px 22px;
      font-size: 14px;
    }
    .playground {
      width: 100%;
      max-width: 420px;
      margin: 14px auto 0;
    }
    .canvas-wrap {
      height: auto;
      aspect-ratio: 1.2;
    }
    .play-foot {
      margin: -12px 6px 0;
      justify-content: center;
      gap: 22px;
    }
  }
  @media print {
    .playground,
    .actions {
      display: none;
    }
    .rotate .line {
      animation: none;
    }
    /* 打印时两句上下排开 */
    .scroll {
      display: block;
    }
    .scroll .line {
      opacity: 1 !important;
    }
    .hero {
      display: block;
      min-height: auto;
    }
    .copy {
      padding-bottom: 20px;
    }
  }
</style>
