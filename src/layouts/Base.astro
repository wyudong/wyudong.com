---
import '../styles/fonts.generated.css';
import '../styles/global.css';
import latinFont from '../assets/fonts/plus-jakarta-sans.woff2?url';
import cjkFont from '../assets/fonts/noto-sans-sc.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import { LANGS, langOf, switchPath, ui } from '../i18n';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogType?: 'website' | 'article';
}

const { title, description, ogTitle, ogType = 'website' } = Astro.props;
const lang = langOf(Astro);
const other = lang === 'zh' ? 'en' : 'zh';
const canonical = new URL(Astro.url.pathname, Astro.site);
// 两种语言的同一页互为 alternate，x-default 指向中文
const alternates = {
  zh: new URL(switchPath(Astro.url.pathname, 'zh'), Astro.site),
  en: new URL(switchPath(Astro.url.pathname, 'en'), Astro.site),
};
---

<!doctype html>
<html lang={LANGS[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 全站字体只有这两个文件，包含所有页面的用字，一打开就下载，见 scripts/build-fonts.mjs -->
    <link rel="preload" href={latinFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={cjkFont} as="font" type="font/woff2" crossorigin />
    <!-- 只有个别页面用到的字体由页面自己预加载，比如英文首页的斜体标题 -->
    <slot name="head" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf8" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={LANGS.zh.htmlLang} href={alternates.zh} />
    <link rel="alternate" hreflang={LANGS.en.htmlLang} href={alternates.en} />
    <link rel="alternate" hreflang="x-default" href={alternates.zh} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LANGS[lang].ogLocale} />
    <meta property="og:locale:alternate" content={LANGS[other].ogLocale} />
  </head>
  <body>
    <a class="skip" href="#main">
      {ui[lang].skip}
    </a>
    <div class="shell">
      <SiteHeader />
    </div>
    <main id="main" class="shell">
      <slot />
    </main>
    <div class="shell">
      <Footer />
    </div>
  </body>
</html>
