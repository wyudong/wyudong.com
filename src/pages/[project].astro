---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import ProjectPage from '../components/ProjectPage.astro';
import { projectPaths } from '../projects';

// 每个项目一页：/fydeos/、/zhong-da-yuan/、/merryking/、/soundlinks/，内容在 src/content/projects/*.mdx
export const getStaticPaths = (() => projectPaths('zh')) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, next }: Props = Astro.props;
---

<ProjectPage entry={entry} next={next} />
